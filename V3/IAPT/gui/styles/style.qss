*, *:disabled, *:hover, *:pressed {
    [[classes:global]]
}
/* #region Filters */
#filters {
    [[classes:side_menu]];
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
}

#filters_collapsed_btn {
    [[classes:nav_collapsed_btn]];
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    margin: 10px 0;
}

#filters_label {
    [[classes:heading]];
    border-top-left-radius: 20px;
}

#filters > QWidget QPushButton {
    [[classes:standard_btn]];
}

#filters > QWidget QPushButton:hover {
    [[classes:standard_btn_hover]];
}

#filters > QWidget QPushButton:pressed {
    [[classes:standard_btn_pressed]];
}

#filters QLabel[variant="subheading"] {
    background-color: [[colours:accent]];
    font-size: 15px;
    font-weight: bold;
    padding: 5px;
}

#filters QComboBox {
    padding: 5px 5px 5px 10px;
    background-color: [[colours:secondary]];
}

#filters QCheckBox {
    padding: 5px;
    background-color: [[colours:secondary]];
}

#filters QCheckBox::indicator {
    background-color: [[colours:secondary]];
    width: 18px;
    height: 18px;
    border: 2px solid [[colours:border_primary]];
    border-radius: 10px;
}

#filters QCheckBox:hover, #filters QCheckBox::indicator:hover, #filters QCheckBox::indicator:checked, #filters QComboBox:hover, #filters QDateEdit:hover, #filters QLineEdit:hover {
    background-color: [[colours:secondary_highlight]];
}

#filters QCheckBox:pressed, #filters QCheckBox::indicator:pressed, #filters QComboBox:pressed, #filters QDateEdit:pressed {
    background-color: [[colours:secondary_pressed]];
}

#filters QCheckBox::indicator:checked {
    background-color: [[colours:error]];
}

#filters QDateEdit {
    padding: 5px 5px 5px 10px;
    background-color: [[colours:secondary]];
}

#filters QLineEdit {
    padding: 5px 5px 5px 10px;
    background-color: [[colours:secondary]];
}
/* #endregion */

/* #region Footer */
#quote {
    padding: 5px;
    background-color: [[colours:accent]];
}
/* #endregion */

/* #region Header */
#header {
    background-color: [[colours:accent]];
}

#program_title {
    font-size: 25px;
    padding: 5px;
    font-weight: bold;
}

#back_btn, #forward_btn {
    [[classes:header_button]];
}

#back_btn:hover, #forward_btn:hover {
    [[classes:header_button_hover]];
}

#back_btn:pressed, #forward_btn:pressed {
    [[classes:header_button_pressed]];
}

#back_btn:disabled, #forward_btn:disabled {
    [[classes:header_button_disabled]];
}
/* #endregion */

/* #region Imports Page */
#import_students_btn_content {
    background-color: [[colours:background_tertiary]];
}

#import_students_btn QLabel {
    font-size: [[font_sizes:heading]];
}

#import_students_btn QLineEdit {
    background-color: [[colours:background_secondary]];
    border: [[borders:standard]] [[colours:border_secondary]];
    border-radius: [[radius:standard_lineedit]];
    margin: 0 20px;
    padding: 5px;
}
/* #endregion */

/* #region Navigation */
#navigation {
    [[classes:side_menu]];
    border-top-right-radius: [[radius:standard]];
    border-bottom-right-radius: [[radius:standard]];
}

#navigation_collapsed_btn {
    [[classes:nav_collapsed_btn]];
    border-top-right-radius: [[radius:standard]];
    border-bottom-right-radius: [[radius:standard]];
    margin: 10px 0;
}

#navigation_label {
    border-top-right-radius: [[radius:standard]];
    [[classes:heading]]
}

#navigation QWidget QPushButton {
    [[classes:standard_btn]];
}

#navigation QWidget QPushButton:hover {
    [[classes:standard_btn_hover]];
}

#navigation QWidget QPushButton:pressed {
    [[classes:standard_btn_pressed]];
}
/* #endregion */

/* #region Notifications */
#notifications > QWidget {
    border: 2px solid [[colours:border_primary]];
    border-radius: 15px;
}

#notifications QWidget[variant="notification_header"] QLabel {
    font-size: [[font_sizes:notification_label]];
    font-weight: bold;
    padding: 5px;
}

#notifications QWidget[variant="notification_header"] QPushButton {
    padding: 5px;
    margin-top: 1px;
    border-radius: 15px;
}

#notifications > QWidget[variant="SUCCESS"] {
    background-color: [[colours:success]];
}

#notifications > QWidget[variant="WARNING"] {
    background-color: [[colours:warning]];
}

#notifications > QWidget[variant="ERROR"] {
    background-color: [[colours:error]];
}

#notifications > QWidget[variant="SUCCESS"] QPushButton:hover {
    background-color: [[colours:success_highlight]];
}

#notifications > QWidget[variant="WARNING"] QPushButton:hover {
    background-color: [[colours:warning_highlight]];
}

#notifications > QWidget[variant="ERROR"] QPushButton:hover {
    background-color: [[colours:error_highlight]];
}

#notifications QProgressBar {
    margin-left: 2px;
    margin-right: 2px;
}

#notifications QProgressBar::chunk {
    background-color: [[colours:success_progress]];
}


/* #endregion */

/* #region Search */
#search {
    background-color: [[colours:accent]];
    border-bottom-left-radius: 15px;
    margin-left: 10px;
}

#search_label {
    margin-left: 15px;
    margin-right: 5px;
    font-weight: bold;
}

#searchbox {
    background-color: [[colours:background_secondary]];
    height: 25px;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    margin: 5px 0;
    padding: 0 6px 4px;
}

#search_results {
    background-color: [[colours:background_tertiary]];
    border: 2px solid [[colours:border_secondary]];
    border-radius: 20px;
}

#search_results QLabel[variant="subheading"] {
    background-color: transparent;
    font-size: 14px;
    padding: 10px;
}

#search_results QLabel {
    padding: 10px;
    background-color: [[colours:secondary]];
}

#search_results QPushButton {
    background-color: transparent;
    text-align: left;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
}

#search_results QPushButton:hover {
    color: [[colours:text_highlight]];
    background-color: [[colours:background_tertiary_highlight]];
}
/* #endregion */

/* #region General Pages */
#main_content {
    margin: 10px;
    border-radius: [[radius:standard]];
    background-color: [[colours:background_secondary]];
    border: [[borders:standard]] [[colours:border_primary]];
}

#page_title {
    [[classes:heading]];
    border-top-left-radius: [[radius:standard]];
    border-top-right-radius: [[radius:standard]];
}

#main_content QTableWidget {
    border-radius: [[radius:standard]];
}

#main_content QTableWidget::item {
    background-color: transparent;
}

#main_content QHeaderView {
    font-weight: bold;
    font-size: [[font_sizes:table_header]];
    background-color: [[colours:accent]];
}

#main_content QLabel[variant="subheading"] {
    background-color: [[colours:secondary]];
    padding: 5px;
    font-weight: bold;
    font-size: 14px;
}

#main_content QPushButton[variant="Citizen"] {
    color: [[colours:citizen]];
}

#main_content QPushButton[variant="Maker"] {
    color: [[colours:maker]];
}

#main_content QPushButton[variant="Worker"] {
    color: [[colours:worker]];
}

#main_content QPushButton[variant="Entrepreneur"] {
    color: [[colours:entrepreneur]];
}

#main_content QPushButton[variant="Citizen"]:hover {
    color: [[colours:citizen_highlight]];
}

#main_content QPushButton[variant="Maker"]:hover {
    color: [[colours:maker_highlight]];
}

#main_content QPushButton[variant="Worker"]:hover {
    color: [[colours:worker_highlight]];
}

#main_content QPushButton[variant="Entrepreneur"]:hover {
    color: [[colours:entrepreneur_highlight]];
}

#main_content QLabel[variant="subheading_red"] {
    background-color: [[colours:outstanding_homework]];
    padding: 5px;
    font-weight: bold;
}

#main_content QLabel[variant="subheading_yellow"] {
    background-color: [[colours:late_homework]];
    padding: 5px;
    font-weight: bold;
}

#main_content QLabel[variant="subheading_green"] {
    background-color: [[colours:completed_homework]];
    padding: 5px;
    font-weight: bold;
}
/* #endregion */

/* #region Imports Page */
#imports_page QPushButton {
    [[classes:standard_btn]];
}

#imports_page QPushButton:hover {
    [[classes:standard_btn_hover]];
}

#imports_page QPushButton:pressed {
    [[classes:standard_btn_pressed]];
}

#imports_page QPushButton:disabled {
    [[classes:standard_btn_disabled]];
}
/* #endregion */

/* #region Student Page */
#student_info QWidget {
    min-height: 5px;
}

#student_info QLabel {
    background-color: [[colours:secondary]];
    padding: 5px;
    border: 2px solid [[colours:border_secondary]];
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
}

#student_info QLineEdit, #student_info QCheckBox {
    background-color: [[colours:background_tertiary]];
    border: 2px solid [[colours:border_secondary]];
    padding: 5px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
}

#student_info QCheckBox::indicator {
    subcontrol-position: center;
}

#student_info QLineEdit:hover, #student_info QComboBox:hover, #student_info QDateEdit:hover, #student_info QCheckBox:hover {
    background-color: [[colours:background_tertiary_highlight]];
}

#student_page QProgressBar {
    margin: 5px 10px;
    background-color: [[colours:secondary]];
    border-radius: 5px;
    height: 5px;
}

#student_page QProgressBar[variant="silver_progress"]::chunk {
    background-color: [[colours:silver]];
    border-radius: 5px;
}

#student_page QProgressBar[variant="bronze_progress"]::chunk {
    background-color: [[colours:bronze]];
    border-radius: 5px;
}

#weekly_points {
    padding: 5px;
    background-color: [[colours:accent]];
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
}

#student_page QLabel[variant="citizen_dot"] {
    border: 10px solid [[colours:citizen]];
}

#student_page QLabel[variant="worker_dot"] {
    border: 10px solid [[colours:worker]];
}

#student_page QLabel[variant="maker_dot"] {
    border: 10px solid [[colours:maker]];
}

#student_page QLabel[variant="entrepreneur_dot"] {
    border: 10px solid [[colours:entrepreneur]];
}

#category_progress > QWidget > QLabel {
    border-radius: 65px;
    min-height: 110px;
    min-width: 110px;
    background-color: [[colours:background_tertiary]];
}
/* #endregion */

/* #region Class Page */
#summary_box > QWidget > QLabel {
    border: 10px solid white;
    border-radius: 45px;
    font-size: 15px;
    min-height: 70px;
}

#summary_box > QWidget > QLabel[variant="missing_total"] {
    border-color: [[colours:outstanding]];
}

#summary_box > QWidget > QLabel[variant="late_total"] {
    border-color: [[colours:late]];
}

#summary_box > QWidget > QLabel[variant="completed_total"] {
    border-color: [[colours:completed]];
}
/* #endregion */

/* #region Homework Page */
#homework_info QWidget {
    min-height: 5px;
}

#homework_info QLabel {
    background-color: [[colours:secondary]];
    padding: 5px;
    border: 2px solid [[colours:border_secondary]];
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
}

#homework_info QLineEdit, #homework_info QComboBox, #homework_info QDateEdit {
    background-color: [[colours:background_tertiary]];
    border: 2px solid [[colours:border_secondary]];
    padding: 5px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
}

#homework_info QLineEdit:hover, #homework_info QComboBox:hover, #homework_info QDateEdit:hover {
    background-color: [[colours:background_tertiary_highlight]];
}

#homework_info QComboBox::drop-down {
    border: none;
    width: 0px;
}

#homework_info QDateEdit::drop-down {
    border: none;
    width: 0px;
}
/* #endregion */

/* #region Latest Homework Page */
#missing_homeworks QHeaderView {
    background-color: [[colours:outstanding_homework]];
}

#late_homeworks QHeaderView {
    background-color: [[colours:late_homework]];
}

#completed_homeworks QHeaderView {
    background-color: [[colours:completed_homework]];
}

#awarded_homeworks QLabel[variant="subheading"] {
    background-color: [[colours:accent]];
}
/* #endregion */

/* #region Settings Page */
#settings_page > QWidget > QWidget > QWidget > QWidget > QWidget > QWidget > QLabel {
    background-color: [[colours:accent]];
    padding: 5px;
    border: 2px solid [[colours:border_secondary]];
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
}

#settings_page QLineEdit, #settings_page QCheckBox {
    background-color: [[colours:background_tertiary]];
    border: 2px solid [[colours:border_secondary]];
    padding: 5px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
}

#settings_page QCheckBox::indicator {
    subcontrol-position: center;
}

#settings_page QLineEdit:hover, #settings_page QComboBox:hover, #settings_page QDateEdit:hover, #settings_page QCheckBox:hover {
    background-color: [[colours:background_tertiary_highlight]];
}
/* #endregion */