{
  "colours": {
    "background_primary": "#111111",
    "background_secondary": "#181818",
    "background_tertiary": "#202020",
    "background_tertiary_highlight": "#2B2B2B",
    "accent": "#1F5F3F",
    "accent_highlight": "#2E8B57",
    "accent_pressed": "#16452E",
    "secondary": "#4B4A72",
    "secondary_highlight": "#65639A",
    "secondary_pressed": "#393852",
    "secondary_disabled": "#28283D",
    "text": "#E8E8E8",
    "text_highlight": "#FFFFFF",
    "text_pressed": "#B8D8C6",
    "text_disabled": "#777777",
    "border_primary": "#2A2A2A",
    "border_secondary": "#353535",
    "disabled": "#4A4A4A",
    "success": "#2E8B57",
    "success_highlight": "#3CB371",
    "success_pressed": "#246B45",
    "success_progress": "#66CDAA",
    "warning": "#B8860B",
    "warning_highlight": "#DAA520",
    "warning_pressed": "#966F09",
    "error": "#B22222",
    "error_highlight": "#DC3545",
    "error_pressed": "#8F1B18",
    "bronze": "#A8753A",
    "silver": "#8F9AA3",
    "outstanding": "#FF6B6B",
    "late": "#FFC857",
    "completed": "#6FC08A",
    "outstanding_homework": "#815052",
    "late_homework": "#8D8051",
    "completed_homework": "#52705D",
    "missing": "#9B59B6",
    "citizen": "#0070C0",
    "worker": "#00B050",
    "maker": "#ED7D31",
    "entrepreneur": "#A678C2",
    "citizen_highlight": "#3399D6",
    "worker_highlight": "#33C875",
    "maker_highlight": "#F3A064",
    "entrepreneur_highlight": "#C39DDA"
  },
  "classes": {
    "global": "font-family: \"Comic Sans MS\"; font-size: 13px; color: [[colours:text]]; background-color: transparent; gridline-color: transparent; border: 0;",
    "heading": "font-size: 16px; font-weight: bold; background-color: [[colours:accent]]; padding: 5px; border-bottom: 2px solid [[colours:border_primary]];",
    "header_button": "border: 2px solid [[colours:text]]; border-radius: 10px;",
    "header_button_hover": "background-color: [[colours:accent_highlight]];",
    "header_button_pressed": "background-color: [[colours:accent_pressed]];",
    "header_button_disabled": "background-color: [[colours:accent_pressed]]; border-color: [[colours:text_disabled]];",
    "side_menu": "background-color: [[colours:background_secondary]]; margin: 10px 0; border: 2px solid [[colours:border_primary]];",
    "nav_collapsed_btn": "background-color: [[colours:secondary]]; padding: 5px;",
    "nav_collapsed_btn_hover": "background-color: [[colours:secondary_highlight]];",
    "nav_collapsed_btn_pressed": "background-color: [[colours:secondary_pressed]];",
    "standard_btn": "background-color: [[colours:secondary]]; padding: 5px; color: [[colours:text]];",
    "standard_btn_hover": "background-color: [[colours:secondary_highlight]];",
    "standard_btn_pressed": "background-color: [[colours:secondary_pressed]];",
    "standard_btn_disabled": "background-color: [[colours:secondary_disabled]]; color: [[colours:text_disabled]];"
  }
}
